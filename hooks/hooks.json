{
  "description": "Ping-Hooks (ping.ps1) und Mod (register.ts)",
  "modules": ["./register.ts"],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/ping.ps1\" Notification || true",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/ping.ps1\" Stop || true",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
