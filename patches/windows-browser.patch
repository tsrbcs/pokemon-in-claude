+// Quick Save / Quick Load: Schnappschuss des ganzen Spielspeichers (nur die belegten 64-KB-Seiten).
+// Der Spielstand im Flash-Speicher bleibt beim Laden unberuehrt, sonst ginge echter Fortschritt verloren.
+const PAGE_BYTES = 65536;
+let quickState = null;
+
+function snapshotPages() {
+  const pages = new Map();
+  const wordsPerPage = PAGE_BYTES / 4;
+  for (let page = 0; page < u32.length / wordsPerPage; page++) {
+    const start = page * wordsPerPage;
+    for (let i = start; i < start + wordsPerPage; i++) {
+      if (u32[i] !== 0) {
+        pages.set(page, u8.slice(page * PAGE_BYTES, (page + 1) * PAGE_BYTES));
+        break;
+      }
+    }
+  }
+  return pages;
+}
+
+function flashQuickLabel(button, text) {
+  const original = button.dataset.label ?? button.textContent;
+  button.dataset.label = original;
+  button.textContent = text;
+  clearTimeout(button.labelTimer);
+  button.labelTimer = setTimeout(() => { button.textContent = original; }, 1500);
+}
+
+function quickSave() {
+  if (!u8) return;
+  quickState = { pages: snapshotPages() };
+  quickLoadButton.disabled = false;
+  flashQuickLabel(quickSaveButton, 'Saved');
+}
+
+function quickLoad() {
+  if (!u8 || !quickState) return;
+  const flash = flashBytes().slice();
+  for (let page = 0; page < u8.length / PAGE_BYTES; page++) {
+    const saved = quickState.pages.get(page);
+    if (saved) u8.set(saved, page * PAGE_BYTES);
+    else u8.fill(0, page * PAGE_BYTES, (page + 1) * PAGE_BYTES);
+  }
+  flashBytes().set(flash);
+  [...pressed].forEach((name) => setPressed(name, false));
+  pendingPresses.clear();
+  writeKeys();
+  flashQuickLabel(quickLoadButton, 'Loaded');
+}
+
+quickSaveButton.addEventListener('click', () => { quickSave(); quickSaveButton.blur(); });
+quickLoadButton.addEventListener('click', () => { quickLoad(); quickLoadButton.blur(); });
+
 window.addEventListener('keydown', (event) => {
